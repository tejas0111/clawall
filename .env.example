# Sui Configuration
PACKAGE_ID=
YOUR_ADDRESS=
NETWORK=testnet
RPC_URL=https://rpc.testnet.sui.io

PRIVATE_KEY=suiprivkey...
GUARD_CAP_ID=
# GlobalFreeze object id from package init; checked on every transfer execution
FREEZE_STATE_ID=
# Dedicated cap for policy-anchor writes (keep off runtime agent host)
POLICY_CAP_ID=


# Walrus Configuration
WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space
# Optional Walrus upload relay for more reliable writes (auto-derived from publisher if unset)
WALRUS_UPLOAD_RELAY=https://upload-relay.testnet.walrus.space
WALRUS_UPLOAD_RELAY_TIP_MAX=1000
WALRUS_REQ_TIMEOUT_MS=60000
# auto = blob then quilt fallback | blob = blob only | quilt = quilt only
WALRUS_AUDIT_MODE=auto
OS_QUILT_ENABLED=1
# Optional override; defaults to PRIVATE_KEY when unset
OS_AUDIT_PRIVATE_KEY=


# Telegram configuration
TG_BOT_TOKEN=
TG_CHAT_ID=
# Required when TG_BOT_TOKEN and TG_CHAT_ID are set
TG_OPERATOR_IDS=
TG_OPERATOR_USERNAMES=
APPROVAL_TIMEOUT_MS=60000
CONSTRAINT_TTL_MS=300000


# OS policy and sequence firewall
# Comma-separated host/domain allowlist for curl/wget egress.
# Supports exact hostnames and wildcard suffixes (*.example.com).
OS_EGRESS_ALLOWLIST=docs.sui.io,*.walrus.space
OS_EGRESS_BLOCK_PRIVATE=1
SEQUENCE_WINDOW_MS=300000
SEQUENCE_BLOCK_THRESHOLD=3
# Optional: auto-unfreeze after critical OS freeze (ms). Leave empty for manual unfreeze only.
OS_FREEZE_DURATION_MS=


# Policy bundle integrity
# auto: enforce only if signature present | strict: always enforce | off: disable
POLICY_INTEGRITY_MODE=auto
# Optional override for expected policy hash (64-char lowercase hex)
POLICY_BUNDLE_SHA256=


# On-chain policy anchor
# auto: enforce when POLICY_ANCHOR_ID is set | strict: always enforce
POLICY_ANCHOR_MODE=auto
POLICY_ANCHOR_ID=
POLICY_ANCHOR_CACHE_MS=60000
ENFORCE_CAP_ISOLATION=1


# Prompt quarantine release window
PROMPT_QUARANTINE_RELEASE_TTL_MS=1800000


# Value-based blockchain risk scoring (USD)
# Coin prices are fetched live per transfer (RPC metadata + oracle/API market data).
SAFE_VALUE_USD=50
HIGH_VALUE_USD=150
MARKET_CACHE_MS=60000
# Optional CoinGecko API keys (use one)
# Demo key format example: CG-xxxx
COINGECKO_DEMO_API_KEY=
COINGECKO_PRO_API_KEY=
# single: one remote request max per token pricing; fallback: try next source if first fails
MARKET_PRICE_REQUEST_MODE=single
# Optional symbol list treated as stablecoin fallback at $1 when providers fail.
MARKET_STABLE_SYMBOLS=USDC,USDT,FDUSD,USDE
# Optional fixed prices (JSON object maps).
# Example: {"WAL":0.42,"HASUI":1.21,"HAWAL":0.39}
MARKET_FIXED_PRICE_USD_BY_SYMBOL_JSON=
# Example: {"0x...::wal::WAL":0.42}
MARKET_FIXED_PRICE_USD_BY_COIN_TYPE_JSON=
# Optional CoinGecko id maps (preferred for tokens with known IDs).
# Example: {"USDC":"usd-coin","HASUI":"haedal-staked-sui","WAL":"walrus-2","HAWAL":"haedal-staked-wal"}
# Defaults are built-in for USDC/HASUI/WAL/HAWAL; set this only to override/extend.
MARKET_COINGECKO_ID_BY_SYMBOL_JSON=
# Example: {"0x...::wal::WAL":"walrus-protocol"}
MARKET_COINGECKO_ID_BY_COIN_TYPE_JSON=
